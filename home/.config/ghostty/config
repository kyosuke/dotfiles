# シェル。herdr は名前を指定しなくても永続セッションへ自動で再接続する。
# ログインシェル(zsh)経由で起動して PATH を解決してから herdr を exec する。
# これで herdr も default_shell の fish もインストール先をハードコードせず
# 名前解決でき、Intel/Apple Silicon どちらでも動く。
command = /bin/zsh --login -c "exec herdr"
shell-integration = fish

# タブは使わない（多重化は herdr 側で行う）。
# transparent だと macOS ネイティブのタブ扱いになり、2タブ以上のときだけ
# タブバーが出る。herdr 運用では基本1タブなので表示されない。
macos-titlebar-style = transparent

# タブと分割の ⌘ キーは Ghostty ではなく herdr を操作する。herdr の prefix(ctrl+b) とキーを送る。
# herdr 側で cmd を直接バインドするより、端末のキー転送に依存しないこちらを選んだ。
# prefix を変えたら \x02 も直す。
keybind = super+t=text:\x02c
keybind = super+shift+]=text:\x02n
keybind = super+shift+[=text:\x02p
keybind = super+d=text:\x02v
keybind = super+shift+d=text:\x02-
keybind = super+digit_1=text:\x021
keybind = super+digit_2=text:\x022
keybind = super+digit_3=text:\x023
keybind = super+digit_4=text:\x024
keybind = super+digit_5=text:\x025
keybind = super+digit_6=text:\x026
keybind = super+digit_7=text:\x027
keybind = super+digit_8=text:\x028
keybind = super+digit_9=text:\x029
keybind = super+[=text:\x02\x1b[Z
keybind = super+]=text:\x02\t
keybind = super+alt+arrow_left=text:\x02h
keybind = super+alt+arrow_down=text:\x02j
keybind = super+alt+arrow_up=text:\x02k
keybind = super+alt+arrow_right=text:\x02l
keybind = super+shift+enter=text:\x02z

# clear_screen は Ghostty の画面を消すだけで、herdr が描き直すため効かない。
# ペインへ ctrl+l を送ってシェルにクリアさせる。
keybind = super+k=text:\x0c

# ctrl 系は unbind して herdr や TUI 側へパススルーする。
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind

# フルスクリーンはデフォルトの cmd+ctrl+f が残るので、そちらを使う。
keybind = super+enter=unbind

# テーマ
theme = "GitHub Dark Dimmed"

# 背景
background-opacity = 0.90
background-blur = true

# フォント
font-family = "PlemolJP35 Console NF"
font-size = 14

# 余白
window-padding-x = 12
window-padding-y = 8

# ウィンドウサイズ（縦幅最大）
window-height = 999
window-width = 160
