{
  "description": "Codex hooks for Herdr session identity and sidebar summaries.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/kyosuke/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python3 \"$HOME/.codex/herdr-codex-summary.py\"",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 \"$HOME/.codex/herdr-codex-summary.py\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 \"$HOME/.codex/herdr-codex-summary.py\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "python3 \"$HOME/.codex/herdr-codex-summary.py\"",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ]
  }
}
